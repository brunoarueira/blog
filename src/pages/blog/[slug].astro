---
// ?inline -> processed CSS as a string, so it can be inlined in <head> on
// code posts only (instead of two render-blocking <link>s).
import prismTheme from 'prism-themes/themes/prism-nord.css?inline';
import prismLineNumbers from 'prismjs/plugins/line-numbers/prism-line-numbers.css?inline';

import { getCollection, render } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import SocialShare from "../../components/SocialShare.astro";
import StyledLink from "../../components/StyledLink.astro";
import { sortByDate } from "../../utils/sortByDate";
import { createExcerpt } from "../../utils/create-excerpt";
import { siteName } from "../../utils/site";

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const numberOfPosts = allPosts.length;

  return allPosts.sort(sortByDate).map((post, i) => {
    const previousPost = i + 1 === numberOfPosts ? { data: undefined } : allPosts[i + 1];
    const nextPost = i === 0 ? { data: undefined } : allPosts[i - 1];

    return {
      params: { slug: post.data.slug },
      props: {
        post,
	previousPost,
	nextPost
      }
    }
  });
}

const { post, previousPost, nextPost } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

const dateOptions: Intl.DateTimeFormatOptions = {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: '2-digit'
};

// Raw Markdown mirror of this post, served by blog/[slug].md.ts.
const markdownHref = `/blog/${post.data.slug}.md`;

// Structured data for search engines and AI answer engines, so they get
// unambiguous title/date/author instead of having to parse the rendered
// page. Reuses the same excerpt logic as feed.xml.js/llms.txt.ts.
const canonicalUrl = new URL(`/blog/${post.data.slug}/`, Astro.site);
const ogImageUrl = new URL('/default-og-image.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: createExcerpt(post.body ?? '').substring(0, 200),
  datePublished: new Date(post.data.date).toISOString(),
  keywords: post.data.tags.join(', '),
  image: ogImageUrl.toString(),
  url: canonicalUrl.toString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl.toString(),
  },
  author: {
    '@type': 'Person',
    name: siteName,
    url: Astro.site?.toString(),
  },
  publisher: {
    '@type': 'Person',
    name: siteName,
  },
};
---
<Layout title={post.data.title} frontmatter={post.data}>
  <link rel="alternate" type="text/markdown" title="Markdown version" href={markdownHref} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  {remarkPluginFrontmatter.hasCodeBlocks && (
    <style slot="head" is:inline set:html={prismTheme + prismLineNumbers} />
  )}

  <h1 class="mb-8 mt-6">{post.data.title}</h1>

  <div class="w-full flex items-center mt-0 mb-8 text-gray-600">
    <time class="mr-1">
      {new Date(post.data.date).toLocaleDateString('en', dateOptions)}
    </time>
    {` `}|
    <span class="ml-1 mr-1">
      {remarkPluginFrontmatter.minutesRead}
    </span>
    {` `}|
    <a href={markdownHref} class="ml-1 no-underline hover:underline">View as Markdown</a>
  </div>

  <div class="post">
    <Content />
  </div>

  <SocialShare title={post.data.title} path={post.data.slug} />

  <hr class="mt-6 mb-4" />

  <ul class="flex flex-row justify-between" style="liststyle: 'none';">
    <li>
      {previousPost.data && <StyledLink text={previousPost.data.title} address={`/blog/${previousPost.data.slug}/`} direction="left" />}
    </li>

    <li>
      {nextPost.data && <StyledLink text={nextPost.data.title} address={`/blog/${nextPost.data.slug}/`} />}
    </li>
  </ul>
</Layout>
